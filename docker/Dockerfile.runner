FROM python:3.10-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy the entire project first
COPY . .

# Install uv and Python dependencies
RUN pip install --upgrade pip && \
    pip install uv && \
    uv sync --frozen

# Create data directory
RUN mkdir -p /app/data

# Expose port (will be overridden by environment variable)
EXPOSE 7861

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${LANGFLOW_WORKER_PORT:-7861}/api/v1/health || exit 1

# Start the worker backend
CMD ["sh", "-c", "uv run uvicorn --factory langflow.worker:create_worker_app --host 0.0.0.0 --port ${LANGFLOW_WORKER_PORT:-7861} --loop asyncio --workers 2"] 